    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "esutils": "^2.0.3",
    "gh-pages": "^6.3.0",
    "globals": "^16.4.0",
    "husky": "^9.1.6",
    "jsdom": "^27.0.1",
    "lint-staged": "^15.2.10",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.49",
    "prettier": "^3.5.3",
    "shadcn-ui": "^0.9.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7",
    "vitest": "^4.0.3"
  }
